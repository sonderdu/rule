        "inet6_range": "fc00::/18"
      }
    ],
    "rules": [
      {
        "clash_mode": "direct",
        "server": "dns-cn"
      },
      {
        "clash_mode": "global",
        "server": "dns-fakeip"
      },
      {
        "domain_suffix": [
          "lan",
          "local",
          "localhost"
        ],
        "server": "dns-cn"
      },
      {
        "rule_set": [
          "geosite-cn",
          "geosite-apple"
        ],
        "server": "dns-cn"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "dns-fakeip",
        "rewrite_ttl": 300
      }
    ],
    "final": "dns-proxy",
    "strategy": "prefer_ipv4",
    "reverse_mapping": true
  },
